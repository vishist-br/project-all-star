generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TENANCY RULE: every model except Tenant carries a non-null `tenantId` (column tenant_id)
// and an index that starts with it. Application code must reach tenant data through
// lib/tenant-scope.ts (forTenant). tests/schema-tenancy.test.ts enforces the rule.

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users             User[]
  venues            Venue[]
  sports            Sport[]
  batches           Batch[]
  guardians         Guardian[]
  members           Member[]
  enrollments       BatchMember[]
  sessions          Session[]
  attendance        Attendance[]
  excused           ExcusedAbsence[]
  progressNotes     ProgressNote[]
  progressLinks     ProgressCardLink[]
  holidays          Holiday[]
  levels            Level[]
  memberLevels      MemberLevel[]
  goals             Goal[]
  achievements      Achievement[]
  exercises         Exercise[]
  workoutPlans      WorkoutPlan[]
  planDays          WorkoutPlanDay[]
  planItems         WorkoutPlanItem[]
  planAssignments   PlanAssignment[]
  workoutLogs       WorkoutLog[]
  memberUpdates     MemberUpdate[]
  coachAvailability CoachAvailability[]
  coachCredentials  CoachCredential[]
  sessionBookings   SessionBooking[]
  goalCheckIns      GoalCheckIn[]
  workoutSets       WorkoutSet[]
  classSummaries    ClassSummary[]
  classShares       ClassSummaryShare[]
  skillChecklists   SkillChecklist[]
  skillItems        SkillItem[]
  skillSignOffs     SkillSignOff[]

  @@map("tenants")
}

// The fixed three-way hierarchy: owner, coach, customer (parent for kids).
enum Role {
  OWNER
  COACH
  CUSTOMER
}

model User {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  role      Role
  email     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches             Batch[]             @relation("BatchCoach")
  guardians           Guardian[]
  members             Member[]
  sessions            Session[]           @relation("SessionCoach")
  marked              Attendance[]        @relation("AttendanceMarkedBy")
  excusedBy           ExcusedAbsence[]    @relation("ExcusedCreatedBy")
  awarded             MemberLevel[]       @relation("LevelAwardedBy")
  goalsSet            Goal[]              @relation("GoalCreatedBy")
  plans               WorkoutPlan[]       @relation("PlanCoach")
  assignmentsBy       PlanAssignment[]    @relation("AssignmentBy")
  workoutLogsBy       WorkoutLog[]        @relation("WorkoutLogBy")
  updatesActed        MemberUpdate[]      @relation("MemberUpdateActor")
  availability        CoachAvailability[] @relation("CoachAvailability")
  bookingsBy          SessionBooking[]    @relation("BookingBy")
  credentials         CoachCredential[]   @relation("CredentialCoach")
  credentialsVerified CoachCredential[]   @relation("CredentialVerifier")
  progressNotes       ProgressNote[]      @relation("ProgressNoteAuthor")
  progressLinks       ProgressCardLink[]  @relation("ProgressLinkCreator")
  summariesBy         ClassSummary[]      @relation("SummaryPublishedBy")
  signOffsBy          SkillSignOff[]      @relation("SignOffBy")
  sharesBy            ClassSummaryShare[] @relation("ShareCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Venues, sports, batches and members
// ---------------------------------------------------------------------------

model Venue {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  city      String?
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches      Batch[]
  availability CoachAvailability[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("venues")
}

model Sport {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  slug      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches         Batch[]
  levels          Level[]
  goals           Goal[]
  skillChecklists SkillChecklist[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("sports")
}

enum BatchKind {
  GROUP_CLASS
  ONE_ON_ONE
}

// A recurring batch/class: one coach, one venue, one sport, a weekly schedule.
model Batch {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  venueId    String    @map("venue_id")
  sportId    String    @map("sport_id")
  coachId    String    @map("coach_id") // User with role COACH
  name       String
  kind       BatchKind @default(GROUP_CLASS)
  capacity   Int? // null = no cap
  // Weekly schedule: ISO weekdays (1 = Monday ... 7 = Sunday) and local wall-clock times.
  daysOfWeek Int[]
  startTime  String // "HH:mm" in the venue timezone
  endTime    String // "HH:mm"
  startsOn   DateTime? @db.Date
  endsOn     DateTime? @db.Date
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  sport       Sport         @relation(fields: [sportId], references: [id], onDelete: Restrict)
  coach       User          @relation("BatchCoach", fields: [coachId], references: [id], onDelete: Restrict)
  enrollments BatchMember[]
  sessions    Session[]

  @@index([tenantId, isActive])
  @@index([tenantId, coachId])
  @@index([tenantId, venueId])
  @@index([tenantId, sportId])
  @@map("batches")
}

// Parent/guardian contact for a child member. Minimal data: name and one contact.
// Verified by OTP later; `userId` links the CUSTOMER login once it exists.
model Guardian {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  members Member[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("guardians")
}

// Fee status is display only (cash or UPI marked paid by hand). No payment processing.
enum FeeStatus {
  PAID
  DUE
  OVERDUE
  WAIVED
}

enum FeePaidMethod {
  CASH
  UPI
}

// Minimal personal data on purpose: a display name, a birth year (not a full date of
// birth) and, for adults, an optional login. No photos, addresses or ID numbers.
model Member {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  displayName   String
  birthYear     Int?
  isMinor       Boolean        @default(false)
  guardianId    String?        @map("guardian_id") // set for kids
  userId        String?        @map("user_id") // adult member login (CUSTOMER)
  phone         String? // adults only; kids use the guardian
  joinedOn      DateTime       @default(now()) @db.Date
  isActive      Boolean        @default(true)
  feeStatus     FeeStatus      @default(DUE)
  feeDueOn      DateTime?      @db.Date
  feePaidOn     DateTime?      @db.Date
  feePaidMethod FeePaidMethod?
  leftOn        DateTime?      @db.Date
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardian      Guardian?           @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments   BatchMember[]
  attendance    Attendance[]
  excused       ExcusedAbsence[]
  progressNotes ProgressNote[]
  progressLinks ProgressCardLink[]
  levelHistory  MemberLevel[]
  goals         Goal[]
  achievements  Achievement[]
  assignments   PlanAssignment[]
  workoutLogs   WorkoutLog[]
  updates       MemberUpdate[]
  bookings      SessionBooking[]
  signOffs      SkillSignOff[]
  shares        ClassSummaryShare[]

  @@index([tenantId, isActive])
  @@index([tenantId, guardianId])
  @@index([tenantId, userId])
  @@index([tenantId, feeStatus])
  @@map("members")
}

// Which member is enrolled in which batch (a member can be in several).
model BatchMember {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  batchId   String    @map("batch_id")
  memberId  String    @map("member_id")
  joinedOn  DateTime  @default(now()) @db.Date
  leftOn    DateTime? @db.Date
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch  Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, batchId, memberId])
  @@index([tenantId, memberId])
  @@map("batch_members")
}

// ---------------------------------------------------------------------------
// Sessions, attendance, excused absences and the holiday calendar
// ---------------------------------------------------------------------------
//
// TIMELINE RULE (logic is a later task; the schema only stores what it needs):
// A member's progress timeline is counted in attended sessions. A missed class
// (Attendance.status = ABSENT) pushes the member's expected completion date out by one
// session. It does NOT extend the timeline when
//   (a) the absence is EXCUSED (reason exam, illness, festival or travel), or
//   (b) the session date falls on a Holiday for the tenant (such sessions are also
//       not counted as missed).
// See docs/DATA_MODEL.md.

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Session {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  batchId      String        @map("batch_id")
  coachId      String        @map("coach_id") // coach who actually ran (or was due to run) it
  startsAt     DateTime
  endsAt       DateTime
  status       SessionStatus @default(SCHEDULED)
  completedAt  DateTime?
  coachNote    String?
  // Offline-sync friendly: generated on the device, makes retried uploads idempotent.
  clientId     String?       @map("client_id")
  capacity     Int?
  title        String?
  cancelledAt  DateTime?     @map("cancelled_at")
  cancelReason String?       @map("cancel_reason")
  // Class workout: the plan day the coach attached to this class (null = none).
  planDayId    String?       @map("plan_day_id")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch      Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  coach      User             @relation("SessionCoach", fields: [coachId], references: [id], onDelete: Restrict)
  attendance Attendance[]
  bookings   SessionBooking[]
  excused    ExcusedAbsence[]
  planDay    WorkoutPlanDay?  @relation(fields: [planDayId], references: [id], onDelete: SetNull)
  summaries  ClassSummary[]

  @@unique([tenantId, batchId, startsAt])
  @@unique([tenantId, clientId])
  @@index([tenantId, startsAt])
  @@index([tenantId, coachId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, planDayId])
  @@map("sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ExcuseReason {
  EXAM
  ILLNESS
  FESTIVAL
  TRAVEL
}

// One row per member per session. `reason` is required when status = EXCUSED and must be
// null otherwise (enforced by a CHECK constraint in the migration).
model Attendance {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  sessionId  String           @map("session_id")
  memberId   String           @map("member_id")
  status     AttendanceStatus
  reason     ExcuseReason?
  note       String?
  // Optional photo reference (object-storage key). Nullable: one-tap roll call needs no photo.
  photoRef   String?          @map("photo_ref")
  // Offline-sync: client-generated id (e.g. UUID) for idempotent upsert on resync.
  clientId   String           @map("client_id")
  markedById String           @map("marked_by_id")
  markedAt   DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt // last-write-wins on sync

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  markedBy User    @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, sessionId, memberId])
  @@unique([tenantId, clientId])
  @@index([tenantId, memberId, status])
  @@index([tenantId, updatedAt])
  @@map("attendance")
}

// An absence declared ahead of time (e.g. exam week, family travel). A later task turns
// it into EXCUSED attendance rows for sessions that fall inside the range.
model ExcusedAbsence {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  memberId    String       @map("member_id")
  fromDate    DateTime     @db.Date
  toDate      DateTime     @db.Date
  reason      ExcuseReason
  note        String?
  // STAR-95: optional single session the declaration is for (null = every session in the date range).
  sessionId   String?      @map("session_id")
  // STAR-95: set when the member or parent withdraws the declaration (the row is kept).
  cancelledAt DateTime?    @map("cancelled_at")
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ExcusedCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, memberId, fromDate])
  @@index([tenantId, fromDate, toDate])
  @@index([tenantId, sessionId])
  @@map("excused_absences")
}

// Per-tenant holiday calendar. Sessions on these dates do not count as missed.
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Levels / belts, goals and achievements
// ---------------------------------------------------------------------------

// An ordered level (belt, grade, tier) within a sport, e.g. White (1) < Yellow (2).
model Level {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  sportId   String   @map("sport_id")
  name      String
  rank      Int // 1 = lowest
  colorHex  String? // optional display colour for belts
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sport           Sport            @relation(fields: [sportId], references: [id], onDelete: Cascade)
  history         MemberLevel[]
  goals           Goal[]
  skillChecklists SkillChecklist[]

  @@unique([tenantId, sportId, rank])
  @@unique([tenantId, sportId, name])
  @@map("levels")
}

// Level history timeline: one row each time a member reaches a level. The current level
// is the row with the latest achievedOn for that member and sport.
model MemberLevel {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  memberId    String   @map("member_id")
  levelId     String   @map("level_id")
  achievedOn  DateTime @db.Date
  awardedById String?  @map("awarded_by_id")
  coachNote   String?
  createdAt   DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  level     Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  awardedBy User?  @relation("LevelAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, memberId, levelId])
  @@index([tenantId, memberId, achievedOn])
  @@map("member_levels")
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  DROPPED
}

// A member's goal, optionally tied to a sport and a target level. `targetSessions`
// and `targetDate` give the progress bar something to measure against.
model Goal {
  id             String     @id @default(cuid())
  tenantId       String     @map("tenant_id")
  memberId       String     @map("member_id")
  sportId        String?    @map("sport_id")
  targetLevelId  String?    @map("target_level_id")
  title          String
  targetSessions Int?
  targetDate     DateTime?  @db.Date
  status         GoalStatus @default(ACTIVE)
  metric         GoalMetric @default(SESSIONS_ATTENDED)
  targetValue    Decimal?   @map("target_value") @db.Decimal(10, 2)
  startValue     Decimal?   @map("start_value") @db.Decimal(10, 2)
  unit           String?
  startsOn       DateTime   @default(now()) @map("starts_on") @db.Date
  createdById    String?    @map("created_by_id")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sport        Sport?        @relation(fields: [sportId], references: [id], onDelete: SetNull)
  targetLevel  Level?        @relation(fields: [targetLevelId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  achievements Achievement[]
  checkIns     GoalCheckIn[]

  @@index([tenantId, memberId, status])
  @@map("goals")
}

// What an achievement is measured in. Hourly vs daily-streak is undecided (see the
// Proposed entry in Decisions & Docs); both are representable.
enum MeasureUnit {
  HOURS
  DAYS
  STREAK_DAYS
  SESSIONS
}

model Achievement {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  memberId     String      @map("member_id")
  goalId       String?     @map("goal_id")
  code         String // stable key, e.g. "first_10_sessions"
  title        String
  measureUnit  MeasureUnit @map("measure_unit")
  measureValue Decimal     @map("measure_value") @db.Decimal(10, 2)
  periodStart  DateTime?   @map("period_start")
  periodEnd    DateTime?   @map("period_end")
  earnedAt     DateTime    @default(now())
  createdAt    DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  goal   Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, memberId, code, measureUnit, earnedAt])
  @@index([tenantId, memberId, earnedAt])
  @@map("achievements")
}

// ---------------------------------------------------------------------------
// Sign-in: magic links and sessions
// ---------------------------------------------------------------------------
//
// Tokens are never stored: only their SHA-256 hash. `userId` and `tenantId` are plain
// columns (no Prisma relations) so these models do not touch Tenant or User.

// A single-use, expiring sign-in link for a seeded user. Shared by hand in the POC.
model MagicLink {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, expiresAt])
  @@map("magic_links")
}

// A signed-in session: hashed access and refresh tokens, revocable (sign-out).
model AuthSession {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  userId           String    @map("user_id")
  accessHash       String    @unique @map("access_hash")
  refreshHash      String    @unique @map("refresh_hash")
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now())

  @@index([tenantId, userId])
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// White-label theme
// ---------------------------------------------------------------------------

// One row per tenant. The display name lives on Tenant.name; no row means defaults.
model TenantTheme {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  logoUrl        String?  @map("logo_url")
  primaryColor   String   @map("primary_color") // #RRGGBB
  secondaryColor String   @map("secondary_color")
  accentColor    String?  @map("accent_color")
  defaultLocale  String   @default("en") @map("default_locale") // en | hi | kn
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([tenantId])
  @@map("tenant_themes")
}

// ---------------------------------------------------------------------------
// Exercise catalog
// ---------------------------------------------------------------------------

enum ExerciseSource {
  FREE_EXERCISE_DB // gym entries imported from free-exercise-db (Unlicense)
  ORIGINAL // entries we wrote ourselves for non-gym sports
}

// Catalog rows are copied per tenant by the import script so each business can have its
// own trainers review or edit them (and so every table carries tenant_id). `sportSlug`
// matches Sport.slug but is a plain string: a tenant may load the catalog before it
// creates the sport. Images are deliberately not stored (licence unclear, see THIRD_PARTY.md).
model Exercise {
  id                 String         @id @default(cuid())
  tenantId           String         @map("tenant_id")
  source             ExerciseSource
  sourceId           String         @map("source_id") // stable key from the source / our draft file
  sportSlug          String         @map("sport_slug")
  name               String
  category           String?
  level              String?
  equipment          String?
  force              String?
  mechanic           String?
  primaryMuscles     String[]       @map("primary_muscles")
  secondaryMuscles   String[]       @map("secondary_muscles")
  instructions       String[]
  licence            String // e.g. "Unlicense" or "Original (project)"
  sourceCommit       String?        @map("source_commit")
  // Drafts we wrote start true; a trainer clears it after reviewing. Re-imports never reset it.
  metricType         MetricType     @default(WEIGHT_REPS) @map("metric_type")
  needsTrainerReview Boolean        @default(true) @map("needs_trainer_review")
  reviewedAt         DateTime?      @map("reviewed_at")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planItems WorkoutPlanItem[]

  @@unique([tenantId, source, sourceId])
  @@index([tenantId, sportSlug])
  @@index([tenantId, needsTrainerReview])
  @@map("exercises")
}

// ---------------------------------------------------------------------------
// Sprint 2: workout plans, bookings, availability, updates feed, settings, goal check-ins
// ---------------------------------------------------------------------------

enum PlanCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum WorkoutLogStatus {
  STARTED
  STOPPED
  COMPLETED
  SKIPPED
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
}

enum GoalMetric {
  SESSIONS_ATTENDED
  WORKOUTS_COMPLETED
  LEVEL
  CUSTOM
}

enum MemberUpdateKind {
  PLAN_ASSIGNED
  PLAN_UPDATED
  PLAN_ENDED
  GOAL_SET
  GOAL_UPDATED
  SESSION_SCHEDULED
  SESSION_RESCHEDULED
  SESSION_CANCELLED
  BOOKING_CONFIRMED
  WAITLIST_PROMOTED
  CLASS_SUMMARY
  CLASS_CATCHUP
  CLASS_CATCHUP_EXCUSED
}

model WorkoutPlan {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  coachId     String           @map("coach_id") // creator, User with role COACH or OWNER
  title       String
  description String?
  cadence     PlanCadence
  sportSlug   String?          @map("sport_slug")
  status      PlanStatus       @default(ACTIVE)
  version     Int              @default(1)
  archivedAt  DateTime?        @map("archived_at")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coach       User             @relation("PlanCoach", fields: [coachId], references: [id], onDelete: Restrict)
  days        WorkoutPlanDay[]
  assignments PlanAssignment[]

  @@index([tenantId, coachId, status])
  @@index([tenantId, status])
  @@map("workout_plans")
}

model WorkoutPlanDay {
  id        String            @id @default(cuid())
  tenantId  String            @map("tenant_id")
  planId    String            @map("plan_id")
  dayIndex  Int               @map("day_index") // DAILY: 1; WEEKLY: 1-7 (ISO weekday); MONTHLY: 1-31
  title     String?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  items     WorkoutPlanItem[]
  sessions  Session[]

  @@unique([tenantId, planId, dayIndex])
  @@map("workout_plan_days")
}

model WorkoutPlanItem {
  id                   String         @id @default(cuid())
  tenantId             String         @map("tenant_id")
  dayId                String         @map("day_id")
  exerciseId           String         @map("exercise_id")
  position             Int
  sets                 Int?
  reps                 Int?
  durationSeconds      Int?           @map("duration_seconds")
  restSeconds          Int?           @map("rest_seconds")
  // Superset: items of one day sharing a label ("A") are done back to back for `rounds` rounds.
  supersetGroup        String?        @map("superset_group")
  rounds               Int?
  targetWeightKg       Decimal?       @map("target_weight_kg") @db.Decimal(7, 2)
  targetDistanceMeters Int?           @map("target_distance_meters")
  notes                String?
  archivedAt           DateTime?      @map("archived_at") // kept for history when edited away
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day                  WorkoutPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise             Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  logs                 WorkoutLog[]

  @@index([tenantId, dayId, position])
  @@index([tenantId, exerciseId])
  @@map("workout_plan_items")
}

model PlanAssignment {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  planId       String           @map("plan_id")
  memberId     String           @map("member_id")
  assignedById String           @map("assigned_by_id")
  status       AssignmentStatus @default(ACTIVE)
  startsOn     DateTime         @map("starts_on") @db.Date
  endsOn       DateTime?        @map("ends_on") @db.Date
  planVersion  Int              @map("plan_version")
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedBy   User             @relation("AssignmentBy", fields: [assignedById], references: [id], onDelete: Restrict)
  logs         WorkoutLog[]

  @@index([tenantId, memberId, status])
  @@index([tenantId, planId, status])
  @@map("plan_assignments")
}

model WorkoutLog {
  id                    String           @id @default(cuid())
  tenantId              String           @map("tenant_id")
  assignmentId          String           @map("assignment_id")
  planItemId            String           @map("plan_item_id")
  memberId              String           @map("member_id")
  scheduledFor          DateTime         @map("scheduled_for") @db.Date
  status                WorkoutLogStatus
  startedAt             DateTime?        @map("started_at")
  completedAt           DateTime?        @map("completed_at")
  actualSets            Int?             @map("actual_sets")
  actualReps            Int?             @map("actual_reps")
  actualDurationSeconds Int?             @map("actual_duration_seconds")
  note                  String?
  clientId              String           @map("client_id")
  recordedById          String           @map("recorded_by_id")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment            PlanAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  planItem              WorkoutPlanItem  @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  member                Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedBy            User             @relation("WorkoutLogBy", fields: [recordedById], references: [id], onDelete: Restrict)
  sets                  WorkoutSet[]

  @@unique([tenantId, assignmentId, planItemId, scheduledFor])
  @@unique([tenantId, clientId])
  @@index([tenantId, memberId, scheduledFor])
  @@index([tenantId, status, scheduledFor])
  @@map("workout_logs")
}

// Change feed so customers see coach updates. One row per affected member.
model MemberUpdate {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  memberId   String           @map("member_id")
  actorId    String?          @map("actor_id")
  kind       MemberUpdateKind
  entityType String           @map("entity_type") // plan | assignment | goal | session | booking
  entityId   String           @map("entity_id")
  params     Json             @default("{}") // i18n params, strings only, no personal data of others
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now())
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor      User?            @relation("MemberUpdateActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, memberId, createdAt])
  @@index([tenantId, memberId, readAt])
  @@map("member_updates")
}

model CoachAvailability {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  coachId   String   @map("coach_id")
  weekday   Int // 1-7 ISO
  startTime String   @map("start_time") // "HH:mm" venue timezone
  endTime   String   @map("end_time")
  venueId   String?  @map("venue_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coach     User     @relation("CoachAvailability", fields: [coachId], references: [id], onDelete: Cascade)
  venue     Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([tenantId, coachId, weekday])
  @@map("coach_availability")
}

model SessionBooking {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  sessionId        String        @map("session_id")
  memberId         String        @map("member_id")
  status           BookingStatus
  waitlistPosition Int?          @map("waitlist_position")
  bookedById       String        @map("booked_by_id")
  cancelledAt      DateTime?     @map("cancelled_at")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session          Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member           Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookedBy         User          @relation("BookingBy", fields: [bookedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, sessionId, memberId]) // one row per member per session; re-booking reuses it
  @@index([tenantId, sessionId, status])
  @@index([tenantId, memberId, status])
  @@map("session_bookings")
}

model TenantSettings {
  id                         String   @id @default(cuid())
  tenantId                   String   @map("tenant_id")
  bookingCancelWindowMinutes Int      @default(120) @map("booking_cancel_window_minutes")
  waitlistEnabled            Boolean  @default(true) @map("waitlist_enabled")
  showMissedSessionCost      Boolean  @default(false) @map("show_missed_session_cost")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now()) @updatedAt

  @@unique([tenantId])
  @@map("tenant_settings")
}

// like TenantTheme: no row = defaults; plain tenantId column (no relation) is acceptable

model GoalCheckIn {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  goalId       String   @map("goal_id")
  value        Decimal  @db.Decimal(10, 2)
  note         String?
  recordedOn   DateTime @map("recorded_on") @db.Date
  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([tenantId, goalId, recordedOn])
  @@map("goal_check_ins")
}

/// Coach Insight Directory (STAR-97): a credential a coach claims (certification, issuer, year).
/// It shows as unverified until the owner marks it verified (verifiedAt set).
model CoachCredential {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  coachId      String    @map("coach_id")
  title        String
  issuer       String?
  year         Int?
  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coach        User      @relation("CredentialCoach", fields: [coachId], references: [id], onDelete: Cascade)
  verifiedBy   User?     @relation("CredentialVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([tenantId, coachId])
  @@map("coach_credentials")
}

// ---------------------------------------------------------------------------
// Parent weekly progress card (STAR-96)
// ---------------------------------------------------------------------------

// The coach's short note for one member and one week (weekStart = Monday, tenant calendar). One per week.
model ProgressNote {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  memberId  String   @map("member_id")
  weekStart DateTime @map("week_start") @db.Date
  note      String
  authorId  String   @map("author_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  author User   @relation("ProgressNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, memberId, weekStart])
  @@map("progress_notes")
}

// A shareable, unguessable link to one member's weekly card. Only the SHA-256 hash of the token is stored.
model ProgressCardLink {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  memberId    String    @map("member_id")
  weekStart   DateTime  @map("week_start") @db.Date
  tokenHash   String    @unique @map("token_hash")
  createdById String    @map("created_by_id")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ProgressLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, memberId])
  @@map("progress_card_links")
}

// ---------------------------------------------------------------------------
// Workout engine: metric types, per-set logging, class summaries, skill checklists
// ---------------------------------------------------------------------------

enum MetricType {
  WEIGHT_REPS
  REPS
  TIME
  DISTANCE_TIME
  SCORE
  CHECKLIST
}

enum SetType {
  NORMAL
  WARMUP
  DROP
  FAILURE
}

// One logged set (or run, or attempt block). Which columns are filled depends on the exercise's
// metricType. `clientId` is generated on the device so offline retries are idempotent.
model WorkoutSet {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  logId       String   @map("log_id")
  setNumber   Int      @map("set_number")
  setType     SetType  @default(NORMAL) @map("set_type")
  weightKg    Decimal? @map("weight_kg") @db.Decimal(7, 2)
  reps        Int?
  seconds     Int?
  meters      Int?
  scoreMade   Int?     @map("score_made")
  scoreOf     Int?     @map("score_of")
  rating      Int? // 1-4, optional
  completedAt DateTime @default(now()) @map("completed_at")
  clientId    String   @map("client_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  log    WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId])
  @@index([tenantId, logId, setNumber])
  @@map("workout_sets")
}

// The after-class summary of a session. One per session; republishing updates it.
// `workoutSnapshot` freezes the class workout (blocks with exercise names) at publish time.
model ClassSummary {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  sessionId       String   @map("session_id")
  coachNote       String?  @map("coach_note")
  homePractice    String?  @map("home_practice")
  workoutSnapshot Json?    @map("workout_snapshot")
  publishedAt     DateTime @default(now()) @map("published_at")
  publishedById   String?  @map("published_by_id")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  publishedBy User?               @relation("SummaryPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  shares      ClassSummaryShare[]

  @@unique([tenantId, sessionId])
  @@index([tenantId, publishedAt])
  @@map("class_summaries")
}

// Share link for one member's view of a class summary. Only the SHA-256 hash of the token is
// stored; links expire after 30 days and can be revoked.
model ClassSummaryShare {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  summaryId   String    @map("summary_id")
  memberId    String    @map("member_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now())

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  summary   ClassSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ShareCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, summaryId])
  @@index([tenantId, memberId])
  @@map("class_summary_shares")
}

// A skill checklist: the requirements for a belt/level (levelId set) or a free-standing list
// for a sport without belts (levelId null). Levels and the member level timeline are reused.
model SkillChecklist {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  sportId   String   @map("sport_id")
  levelId   String?  @map("level_id")
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sport  Sport       @relation(fields: [sportId], references: [id], onDelete: Cascade)
  level  Level?      @relation(fields: [levelId], references: [id], onDelete: SetNull)
  items  SkillItem[]

  @@index([tenantId, sportId, sortOrder])
  @@index([tenantId, levelId])
  @@map("skill_checklists")
}

model SkillItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  checklistId String   @map("checklist_id")
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklist SkillChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  signOffs  SkillSignOff[]

  @@index([tenantId, checklistId, sortOrder])
  @@map("skill_items")
}

model SkillSignOff {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  memberId      String   @map("member_id")
  skillItemId   String   @map("skill_item_id")
  rating        Int // 1-4
  note          String?
  signedOffById String?  @map("signed_off_by_id")
  signedOffAt   DateTime @default(now()) @map("signed_off_at")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skillItem   SkillItem @relation(fields: [skillItemId], references: [id], onDelete: Cascade)
  signedOffBy User?     @relation("SignOffBy", fields: [signedOffById], references: [id], onDelete: SetNull)

  @@unique([tenantId, memberId, skillItemId])
  @@index([tenantId, memberId])
  @@map("skill_sign_offs")
}

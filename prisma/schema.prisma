generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TENANCY RULE: every model except Tenant carries a non-null `tenantId` (column tenant_id)
// and an index that starts with it. Application code must reach tenant data through
// lib/tenant-scope.ts (forTenant). tests/schema-tenancy.test.ts enforces the rule.

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users        User[]
  venues       Venue[]
  sports       Sport[]
  batches      Batch[]
  guardians    Guardian[]
  members      Member[]
  enrollments  BatchMember[]
  sessions     Session[]
  attendance   Attendance[]
  excused      ExcusedAbsence[]
  holidays     Holiday[]
  levels       Level[]
  memberLevels MemberLevel[]
  goals        Goal[]
  achievements Achievement[]

  @@map("tenants")
}

// The fixed three-way hierarchy: owner, coach, customer (parent for kids).
enum Role {
  OWNER
  COACH
  CUSTOMER
}

model User {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  role      Role
  email     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches   Batch[]          @relation("BatchCoach")
  guardians Guardian[]
  members   Member[]
  sessions  Session[]        @relation("SessionCoach")
  marked    Attendance[]     @relation("AttendanceMarkedBy")
  excusedBy ExcusedAbsence[] @relation("ExcusedCreatedBy")
  awarded   MemberLevel[]    @relation("LevelAwardedBy")
  goalsSet  Goal[]           @relation("GoalCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Venues, sports, batches and members
// ---------------------------------------------------------------------------

model Venue {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  city      String?
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("venues")
}

model Sport {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  slug      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches Batch[]
  levels  Level[]
  goals   Goal[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("sports")
}

enum BatchKind {
  GROUP_CLASS
  ONE_ON_ONE
}

// A recurring batch/class: one coach, one venue, one sport, a weekly schedule.
model Batch {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  venueId    String    @map("venue_id")
  sportId    String    @map("sport_id")
  coachId    String    @map("coach_id") // User with role COACH
  name       String
  kind       BatchKind @default(GROUP_CLASS)
  capacity   Int? // null = no cap
  // Weekly schedule: ISO weekdays (1 = Monday ... 7 = Sunday) and local wall-clock times.
  daysOfWeek Int[]
  startTime  String // "HH:mm" in the venue timezone
  endTime    String // "HH:mm"
  startsOn   DateTime? @db.Date
  endsOn     DateTime? @db.Date
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  sport       Sport         @relation(fields: [sportId], references: [id], onDelete: Restrict)
  coach       User          @relation("BatchCoach", fields: [coachId], references: [id], onDelete: Restrict)
  enrollments BatchMember[]
  sessions    Session[]

  @@index([tenantId, isActive])
  @@index([tenantId, coachId])
  @@index([tenantId, venueId])
  @@index([tenantId, sportId])
  @@map("batches")
}

// Parent/guardian contact for a child member. Minimal data: name and one contact.
// Verified by OTP later; `userId` links the CUSTOMER login once it exists.
model Guardian {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  members Member[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("guardians")
}

// Fee status is display only (cash or UPI marked paid by hand). No payment processing.
enum FeeStatus {
  PAID
  DUE
  OVERDUE
  WAIVED
}

enum FeePaidMethod {
  CASH
  UPI
}

// Minimal personal data on purpose: a display name, a birth year (not a full date of
// birth) and, for adults, an optional login. No photos, addresses or ID numbers.
model Member {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  displayName   String
  birthYear     Int?
  isMinor       Boolean        @default(false)
  guardianId    String?        @map("guardian_id") // set for kids
  userId        String?        @map("user_id") // adult member login (CUSTOMER)
  phone         String? // adults only; kids use the guardian
  joinedOn      DateTime       @default(now()) @db.Date
  isActive      Boolean        @default(true)
  feeStatus     FeeStatus      @default(DUE)
  feeDueOn      DateTime?      @db.Date
  feePaidOn     DateTime?      @db.Date
  feePaidMethod FeePaidMethod?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardian     Guardian?        @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments  BatchMember[]
  attendance   Attendance[]
  excused      ExcusedAbsence[]
  levelHistory MemberLevel[]
  goals        Goal[]
  achievements Achievement[]

  @@index([tenantId, isActive])
  @@index([tenantId, guardianId])
  @@index([tenantId, userId])
  @@index([tenantId, feeStatus])
  @@map("members")
}

// Which member is enrolled in which batch (a member can be in several).
model BatchMember {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  batchId   String    @map("batch_id")
  memberId  String    @map("member_id")
  joinedOn  DateTime  @default(now()) @db.Date
  leftOn    DateTime? @db.Date
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch  Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, batchId, memberId])
  @@index([tenantId, memberId])
  @@map("batch_members")
}

// ---------------------------------------------------------------------------
// Sessions, attendance, excused absences and the holiday calendar
// ---------------------------------------------------------------------------
//
// TIMELINE RULE (logic is a later task; the schema only stores what it needs):
// A member's progress timeline is counted in attended sessions. A missed class
// (Attendance.status = ABSENT) pushes the member's expected completion date out by one
// session. It does NOT extend the timeline when
//   (a) the absence is EXCUSED (reason exam, illness, festival or travel), or
//   (b) the session date falls on a Holiday for the tenant (such sessions are also
//       not counted as missed).
// See docs/DATA_MODEL.md.

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Session {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  batchId     String        @map("batch_id")
  coachId     String        @map("coach_id") // coach who actually ran (or was due to run) it
  startsAt    DateTime
  endsAt      DateTime
  status      SessionStatus @default(SCHEDULED)
  completedAt DateTime?
  coachNote   String?
  // Offline-sync friendly: generated on the device, makes retried uploads idempotent.
  clientId    String?       @map("client_id")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  coach      User         @relation("SessionCoach", fields: [coachId], references: [id], onDelete: Restrict)
  attendance Attendance[]

  @@unique([tenantId, batchId, startsAt])
  @@unique([tenantId, clientId])
  @@index([tenantId, startsAt])
  @@index([tenantId, coachId, startsAt])
  @@index([tenantId, status, startsAt])
  @@map("sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ExcuseReason {
  EXAM
  ILLNESS
  FESTIVAL
  TRAVEL
}

// One row per member per session. `reason` is required when status = EXCUSED and must be
// null otherwise (enforced by a CHECK constraint in the migration).
model Attendance {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  sessionId  String           @map("session_id")
  memberId   String           @map("member_id")
  status     AttendanceStatus
  reason     ExcuseReason?
  note       String?
  // Optional photo reference (object-storage key). Nullable: one-tap roll call needs no photo.
  photoRef   String?          @map("photo_ref")
  // Offline-sync: client-generated id (e.g. UUID) for idempotent upsert on resync.
  clientId   String           @map("client_id")
  markedById String           @map("marked_by_id")
  markedAt   DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt // last-write-wins on sync

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  markedBy User    @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, sessionId, memberId])
  @@unique([tenantId, clientId])
  @@index([tenantId, memberId, status])
  @@index([tenantId, updatedAt])
  @@map("attendance")
}

// An absence declared ahead of time (e.g. exam week, family travel). A later task turns
// it into EXCUSED attendance rows for sessions that fall inside the range.
model ExcusedAbsence {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  memberId    String       @map("member_id")
  fromDate    DateTime     @db.Date
  toDate      DateTime     @db.Date
  reason      ExcuseReason
  note        String?
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ExcusedCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, memberId, fromDate])
  @@map("excused_absences")
}

// Per-tenant holiday calendar. Sessions on these dates do not count as missed.
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Levels / belts, goals and achievements
// ---------------------------------------------------------------------------

// An ordered level (belt, grade, tier) within a sport, e.g. White (1) < Yellow (2).
model Level {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  sportId   String   @map("sport_id")
  name      String
  rank      Int // 1 = lowest
  colorHex  String? // optional display colour for belts
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sport   Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)
  history MemberLevel[]
  goals   Goal[]

  @@unique([tenantId, sportId, rank])
  @@unique([tenantId, sportId, name])
  @@map("levels")
}

// Level history timeline: one row each time a member reaches a level. The current level
// is the row with the latest achievedOn for that member and sport.
model MemberLevel {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  memberId    String   @map("member_id")
  levelId     String   @map("level_id")
  achievedOn  DateTime @db.Date
  awardedById String?  @map("awarded_by_id")
  coachNote   String?
  createdAt   DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  level     Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  awardedBy User?  @relation("LevelAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, memberId, levelId])
  @@index([tenantId, memberId, achievedOn])
  @@map("member_levels")
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  DROPPED
}

// A member's goal, optionally tied to a sport and a target level. `targetSessions`
// and `targetDate` give the progress bar something to measure against.
model Goal {
  id             String     @id @default(cuid())
  tenantId       String     @map("tenant_id")
  memberId       String     @map("member_id")
  sportId        String?    @map("sport_id")
  targetLevelId  String?    @map("target_level_id")
  title          String
  targetSessions Int?
  targetDate     DateTime?  @db.Date
  status         GoalStatus @default(ACTIVE)
  createdById    String?    @map("created_by_id")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sport        Sport?        @relation(fields: [sportId], references: [id], onDelete: SetNull)
  targetLevel  Level?        @relation(fields: [targetLevelId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  achievements Achievement[]

  @@index([tenantId, memberId, status])
  @@map("goals")
}

// What an achievement is measured in. Hourly vs daily-streak is undecided (see the
// Proposed entry in Decisions & Docs); both are representable.
enum MeasureUnit {
  HOURS
  DAYS
  STREAK_DAYS
  SESSIONS
}

model Achievement {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  memberId     String      @map("member_id")
  goalId       String?     @map("goal_id")
  code         String // stable key, e.g. "first_10_sessions"
  title        String
  measureUnit  MeasureUnit @map("measure_unit")
  measureValue Decimal     @map("measure_value") @db.Decimal(10, 2)
  periodStart  DateTime?   @map("period_start")
  periodEnd    DateTime?   @map("period_end")
  earnedAt     DateTime    @default(now())
  createdAt    DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  goal   Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, memberId, code, measureUnit, earnedAt])
  @@index([tenantId, memberId, earnedAt])
  @@map("achievements")
}

{
  "name": "project-all-star",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolation": "vitest run tests/isolation.test.ts tests/read-endpoints.test.ts tests/auth-access.test.ts tests/auth-policy.test.ts tests/theme.test.ts tests/members-import-api.test.ts tests/magic-link.test.ts tests/tenant-scope.test.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:import-exercises": "tsx prisma/catalog/index.ts",
    "setup": "node scripts/setup.mjs",
    "start:local": "npm run setup && npm run dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "js-yaml": "^4.3.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "sharp": "file:../../vendor/sharp-stub"
  }
}

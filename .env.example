# Copy to .env (npm run setup does this for you). Local development values only; never commit real secrets.
POSTGRES_USER=allstar
POSTGRES_PASSWORD=allstar_local_dev
POSTGRES_DB=allstar
POSTGRES_PORT=5432
DATABASE_URL="postgresql://allstar:allstar_local_dev@localhost:5432/allstar?schema=public"
# Public base URL used to build shareable magic links (/auth/magic?token=...). Local default shown.
APP_BASE_URL="http://localhost:3000"
